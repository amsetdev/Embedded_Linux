# Doxygen config for the gateway application (only non-default settings).
# CI gate: tests/static/doxygen_gate.py fails on ANY warning (DOCS/CI_CD_GUIDE.md §5.6).
# Documented code = what the makefile builds (SRCS) + its headers. Not built,
# therefore excluded: src/fieldbus/modbus.c, src/control_logic.c and their headers
# (doxygen_gate.py checks this list against the makefile).

PROJECT_NAME           = "STM32MP1 gateway"
PROJECT_BRIEF          = "STM32MP157F-DK2 Cortex-A7 Linux gateway: Modbus RTU/TCP master, MQTT (AWS IoT), offline storage, OTA"
OUTPUT_DIRECTORY       = build-docs
INPUT                  = src inc DOCS/DOXYGEN_MAINPAGE.md
USE_MDFILE_AS_MAINPAGE = DOCS/DOXYGEN_MAINPAGE.md
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
EXCLUDE                = src/fieldbus/modbus.c inc/modbus.h \
                         src/control_logic.c inc/control_logic.h
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __attribute__(x)=
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = build-docs/doxygen-warnings.log
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
